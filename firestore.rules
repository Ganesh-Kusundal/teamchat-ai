rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }

    function orgMember(orgSlug) {
      return authenticated() && request.auth.token.orgId == orgSlug;
    }

    function orgAdmin(orgSlug) {
      return orgMember(orgSlug) && request.auth.token.role == 'admin';
    }

    function roomMember(orgSlug, roomId) {
      return orgMember(orgSlug) && exists(
        /databases/$(database)/documents/organizations/$(orgSlug)/rooms/$(roomId)/members/$(request.auth.uid)
      );
    }

    match /organizations/{orgSlug} {
      allow read: if orgMember(orgSlug);
      allow write: if orgAdmin(orgSlug);

      match /users/{uid} {
        allow read: if orgMember(orgSlug);
        allow write: if orgAdmin(orgSlug) || (authenticated() && request.auth.uid == uid && request.resource.data.orgSlug == orgSlug);
      }

      match /rooms/{roomId} {
        allow read: if roomMember(orgSlug, roomId);
        allow create, update, delete: if orgAdmin(orgSlug);

        match /members/{memberId} {
          allow read: if roomMember(orgSlug, roomId);
          allow write: if orgAdmin(orgSlug);
        }

        match /messages/{messageId} {
          allow read: if roomMember(orgSlug, roomId);
          allow create: if roomMember(orgSlug, roomId)
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.orgSlug == orgSlug
            && request.resource.data.roomId == roomId;
          allow update, delete: if orgAdmin(orgSlug);
        }

        match /presence/{uid} {
          allow read: if orgMember(orgSlug);
          allow write: if authenticated() && request.auth.uid == uid;
        }

        match /typing/{uid} {
          allow read: if roomMember(orgSlug, roomId);
          allow write: if authenticated() && request.auth.uid == uid;
        }
      }

      match /memories/{memoryId} {
        allow read: if orgMember(orgSlug);
        allow create, update: if orgMember(orgSlug) && request.resource.data.org_slug == orgSlug;
        allow delete: if orgAdmin(orgSlug);
      }
    }

    // Browser clients never read this collection; Cloud Run uses Admin SDK.
    match /realtime_events/{eventId} {
      allow read, write: if false;
    }
  }
}
