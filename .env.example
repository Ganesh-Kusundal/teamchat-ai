# ============================================================
# TeamChat AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in values for local development.
# On Cloud Run, set these as environment variables in the service config.

# -----------------------------------------------------------
# Gemini / Vertex AI
# -----------------------------------------------------------
# LOCAL DEV: Get an API key from https://aistudio.google.com
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PRODUCTION (Cloud Run): Set your GCP project.
# When GOOGLE_CLOUD_PROJECT is set the backend switches to Vertex AI mode
# automatically and uses workload identity — no API key needed.
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"

# -----------------------------------------------------------
# Firebase Auth and Firestore (production)
# -----------------------------------------------------------
# Set FIREBASE_PROJECT_ID to require Firebase ID tokens; demo tokens are then rejected.
FIREBASE_PROJECT_ID=""
# Web API key is only used by the backend password-login endpoint in Firebase mode.
FIREBASE_WEB_API_KEY=""
# Select durable tenant-scoped state in production. Keep memory for local evaluation.
STORAGE_BACKEND="memory"
FIRESTORE_DATABASE="(default)"
# Optional: Firestore TTL cleanup is recommended for realtime_events.expiresAt.

# -----------------------------------------------------------
# Application URL
# -----------------------------------------------------------
# Automatically set by Cloud Run at runtime.
APP_URL="http://localhost:8000"
# Comma-separated browser origins; do not use * when credentials are enabled.
CORS_ORIGINS="http://localhost:5173,http://localhost:8000"
