# ============================================================
# TeamChat AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in values for local development.
# On Cloud Run, set these as environment variables in the service config.

# -----------------------------------------------------------
# Gemini / Vertex AI
# -----------------------------------------------------------
# LOCAL DEV: Get an API key from https://aistudio.google.com
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PRODUCTION (Cloud Run): Set your GCP project.
# When GOOGLE_CLOUD_PROJECT is set the backend switches to Vertex AI mode
# automatically and uses workload identity — no API key needed.
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"

# -----------------------------------------------------------
# Firebase Auth (optional)
# -----------------------------------------------------------
# Set this to enable Firebase ID token verification in production.
# Leave empty to use the built-in demo-token mode for local evaluation.
# On Cloud Run, authentication is via Application Default Credentials.
FIREBASE_PROJECT_ID=""

# -----------------------------------------------------------
# Application URL
# -----------------------------------------------------------
# Automatically set by Cloud Run at runtime.
APP_URL="http://localhost:8000"
